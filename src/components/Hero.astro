---
---

<header class="hero" id="accueil">
  <nav class="nav" aria-label="Navigation principale">
    <div class="container nav__inner">
      <a href="/" class="nav__logo" aria-label="Elith Paysages — Accueil">
        <img src="/logo.jpg" alt="Logo Elith Paysages" width="120" height="48" />
      </a>

      <input type="checkbox" id="nav-toggle" class="nav__toggle-input" aria-hidden="true" />
      <label for="nav-toggle" class="nav__burger" aria-label="Ouvrir le menu de navigation">
        <span></span>
        <span></span>
        <span></span>
      </label>

      <ul class="nav__menu" role="list">
        <li><a href="#a-propos" class="nav__link">À propos</a></li>
        <li><a href="#services" class="nav__link">Services</a></li>
        <li><a href="#avis" class="nav__link">Avis</a></li>
        <li><a href="#faq" class="nav__link">FAQ</a></li>
        <li><a href="#contact" class="nav__link">Contact</a></li>
      </ul>
    </div>
  </nav>

  <div class="container hero__inner">
    <div class="hero__content reveal">
      <span class="hero__tag">Paysagiste à Avignon</span>
      <h1 class="hero__title">Transformez votre extérieur en un espace de vie</h1>
      <p class="hero__subtitle">
        Création, entretien et embellissement de jardins sur mesure dans la région PACA.
        Du projet à la réalisation, Elith Paysages vous accompagne avec passion.
      </p>
      <div class="hero__actions">
        <a href="tel:0667724805" class="btn btn-accent">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 11.5a19.79 19.79 0 01-3.07-8.63A2 2 0 012 .84h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
          </svg>
          Appeler maintenant
        </a>
        <a href="#services" class="btn btn-outline-white">Voir nos services</a>
      </div>
    </div>

    <div class="hero__visual reveal reveal-delay-2">
      <img
        src="/photo-1.webp"
        alt="Jardin aménagé par Elith Paysages à Avignon"
        width="800"
        height="500"
        loading="eager"
      />
      <div class="hero__badge" aria-label="Note Google : 5 étoiles sur 5, 8 avis">
        <div class="hero__badge-stars" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#F59E0B"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#F59E0B"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#F59E0B"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#F59E0B"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#F59E0B"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <div class="hero__badge-text">
          <span class="hero__badge-score">5/5</span>
          <span class="hero__badge-label">8 avis Google</span>
        </div>
      </div>
    </div>
  </div>

  <!-- <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-dot"></span>
  </div> -->
</header>

<style>
  .hero {
    background: linear-gradient(150deg, #1a2e1c 0%, var(--color-primary) 100%);
    min-height: 90svh;
    display: flex;
    flex-direction: column;
    color: var(--color-white);
    position: relative;
    overflow: hidden;
    clip-path: ellipse(160% 96% at 50% 4%);
    padding-bottom: 8%;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.04) 0%, transparent 50%),
                      radial-gradient(circle at 80% 20%, rgba(255,255,255,0.04) 0%, transparent 50%);
    pointer-events: none;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: white;
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    position: relative;
  }

  .nav__logo img {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  .nav__toggle-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .nav__burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 10px;
    min-height: 44px;
    min-width: 44px;
    align-items: center;
    justify-content: center;
    z-index: 101;
  }

  .nav__burger span {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
    transition: all var(--transition);
  }

  .nav__toggle-input:checked ~ .nav__burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav__toggle-input:checked ~ .nav__burger span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .nav__toggle-input:checked ~ .nav__burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav__menu {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 68px;
    left: 0;
    right: 0;
    background-color: var(--color-primary-dark);
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    gap: var(--space-xs);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-lg);
  }

  .nav__toggle-input:checked ~ .nav__menu {
    display: flex;
  }

  .nav__link {
    display: flex;
    align-items: center;
    color: white;
    font-weight: 500;
    padding: 0.625rem var(--space-sm);
    min-height: 44px;
  }

  .nav__link:hover {
    /* color: var(--color-primary-dark); */
    /* background-color: var(--color-primary); */
    /* border-bottom: 1px solid var(--color-primary); */
    border-bottom: 1px solid white;
    padding-left: var(--space-md);
  }

  .nav__cta {
    margin-top: var(--space-xs);
    justify-content: center;
  }

  @media (min-width: 768px) {
    .nav__burger {
      display: none;
    }

    .nav__menu {
      display: flex !important;
      flex-direction: row;
      position: static;
      background-color: transparent;
      padding: 0;
      gap: var(--space-xs);
      border-top: none;
      box-shadow: none;
      align-items: center;
    }

    .nav__link {
      color: var(--color-primary);
      font-size: var(--text-sm);
      padding: 0.5rem var(--space-sm);
    }

    .nav__link:hover {
      padding-left: var(--space-sm);
      color: var(--color-primary-dark);
      border-bottom: 1px solid var(--color-primary);
    }
  }

  .hero__inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-3xl) var(--space-2xl);
    gap: var(--space-2xl);
    text-align: center;
  }

  .hero__tag {
    display: inline-block;
    background-color: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.92);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.375rem var(--space-md);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: var(--space-lg);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .hero__subtitle {
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.82);
    max-width: 500px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
  }

  .hero__actions .btn {
    width: 100%;
  }

  .hero__visual {
    width: 100%;
    max-width: 480px;
    position: relative;
  }

  .hero__visual img {
    width: 100%;
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    border: 3px solid rgba(255, 255, 255, 0.15);
  }

  .hero__badge {
    position: absolute;
    bottom: -1rem;
    right: 1rem;
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 0.75rem var(--space-md);
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    border-left: 4px solid var(--color-accent);
  }

  .hero__badge-stars {
    display: flex;
    gap: 2px;
  }

  .hero__badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .hero__badge-score {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .hero__badge-label {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  .hero__scroll {
    position: absolute;
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-full);
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .hero__scroll-dot {
    width: 4px;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 50%;
    animation: scroll-bounce 1.6s ease-in-out infinite;
  }

  @keyframes scroll-bounce {
    0% { transform: translateY(0); opacity: 1; }
    80% { transform: translateY(18px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }

  @media (min-width: 480px) {
    .hero__title {
      font-size: 2.25rem;
    }
  }

  @media (min-width: 768px) {
    .hero__title {
      font-size: 2.75rem;
    }

    .hero__actions {
      flex-direction: row;
      justify-content: center;
      width: auto;
    }

    .hero__actions .btn {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      flex-direction: row;
      text-align: left;
      justify-content: space-between;
      gap: var(--space-3xl);
      padding-block: var(--space-4xl) var(--space-3xl);
    }

    .hero__content {
      flex: 1;
      max-width: 560px;
    }

    .hero__subtitle {
      margin-inline: 0;
    }

    .hero__actions {
      justify-content: flex-start;
    }

    .hero__title {
      font-size: 3.25rem;
    }

    .hero__visual {
      flex: 0 0 auto;
      max-width: 540px;
    }

    .hero__scroll {
      display: none;
    }

    .hero {
      clip-path: ellipse(100% 88% at 50% 12%);
    }
  }
</style>
