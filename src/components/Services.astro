---
const services = [
  {
    title: 'Entretien de jardins',
    description: 'Tonte, désherbage, nettoyage et entretien régulier pour un jardin toujours impeccable tout au long de l\'année.',
    color: '#407243',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
  },
  {
    title: 'Systèmes d\'arrosage',
    description: 'Installation de systèmes d\'arrosage automatique et goutte-à-goutte pour un arrosage optimal et économe en eau.',
    color: '#1565C0',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C8 7 4 10 4 14a8 8 0 0016 0c0-4-4-7-8-12z"/></svg>`,
  },
  {
    title: 'Création de jardins',
    description: 'Conception et réalisation de votre jardin de A à Z, des plans jusqu\'aux finitions, selon vos envies et votre budget.',
    color: '#2E7D32',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22V12m0 0C12 7 7 3.5 3 5.5c0 6 4 9.5 9 6.5zm0 0c0-5 5-8.5 9-6.5 0 6-4 9.5-9 6.5z"/></svg>`,
  },
  {
    title: 'Maçonnerie paysagère',
    description: 'Terrasses, allées, murets et escaliers en pierres naturelles ou matériaux contemporains intégrés harmonieusement au paysage.',
    color: '#A6A6A6',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="14" width="9" height="4" rx="1"/><rect x="13" y="14" width="9" height="4" rx="1"/><rect x="6" y="9" width="12" height="4" rx="1"/><rect x="2" y="4" width="9" height="4" rx="1"/><rect x="13" y="4" width="9" height="4" rx="1"/></svg>`,
  },
  {
    title: 'Permaculture',
    description: 'Conception de jardins-forêts et potagers en permaculture pour cultiver de manière autonome et en harmonie avec la nature.',
    color: '#558B2F',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12c0-3 2-5.5 3-8 1 2.5 3 5 3 8a3 3 0 01-6 0z"/><path d="M12 19v3"/><path d="M7 8.5C5 6.5 3 7 2 9c2 1.5 4.5.5 5-0.5zm10 0c2-2 4-1.5 5 .5-2 1.5-4.5.5-5-.5z"/></svg>`,
  },
  {
    title: 'Traitement phytosanitaire',
    description: 'Diagnostic et traitement des maladies, nuisibles et parasites avec des méthodes raisonnées et des alternatives naturelles.',
    color: '#E65100',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
  },
  {
    title: 'Engazonnement',
    description: 'Pose de gazon en rouleaux ou semis, préparation soignée du terrain et conseils sur les variétés adaptées au climat provençal.',
    color: '#689F38',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18"/><path d="M5 20V13c0-3 2-5 3-7"/><path d="M12 20V11c0-4 2-6 4-9"/><path d="M9 20V9c0-3 1.5-5 3-7"/></svg>`,
  },
  {
    title: 'Élagage',
    description: 'Élagage et abattage d\'arbres réalisés dans les règles de l\'art pour la sécurité de votre propriété et la santé de vos grands arbres.',
    color: '#855921',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="M12 8c-3-3-7-3-9-1 0 4 3 6 9 5z"/><path d="M12 11c3-3 7-3 9-1 0 4-3 6-9 5z"/><path d="M12 15v6"/></svg>`,
  },
  {
    title: 'Taille des végétaux',
    description: 'Taille de formation, d\'entretien et de rajeunissement de vos haies, arbustes et arbres fruitiers pour une croissance saine et équilibrée.',
    color: '#407243',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4L8.12 15.88M14.47 14.48L20 20M8.12 8.12L12 12"/></svg>`,
  },
];
---

<section class="services" id="services" aria-labelledby="services-title">
  <div class="container">
    <header class="section-header reveal">
      <span class="section-tag">Ce que nous faisons</span>
      <h2 class="section-title" id="services-title">Nos prestations paysagères</h2>
      <p class="section-subtitle">De la conception à l'entretien, chaque intervention est réalisée avec soin et expertise pour sublimer votre espace extérieur.</p>
    </header>

    <ul class="services__grid" role="list">
      {services.map((service, i) => (
        <li class={`services__card reveal reveal-delay-${(i % 4) + 1}`} style={`--service-color: ${service.color}`}>
          <div class="services__icon" set:html={service.icon} />
          <h3 class="services__title">{service.title}</h3>
          <p class="services__desc">{service.description}</p>
        </li>
      ))}
    </ul>

    <div class="services__cta reveal">
      <a href="#contact" class="btn btn-primary">Demander un devis gratuit</a>
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--space-4xl);
    background-color: var(--color-neutral);
    position: relative;
  }

  .services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .services__card {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
    border-bottom: 3px solid transparent;
  }

  .services__card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-bottom-color: var(--service-color);
  }

  .services__icon {
    width: 56px;
    height: 56px;
    background-color: color-mix(in srgb, var(--service-color) 12%, transparent);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
    color: var(--service-color);
    transition: background-color var(--transition), color var(--transition);
  }

  .services__card:hover .services__icon {
    background-color: var(--service-color);
    color: var(--color-white);
  }

  .services__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .services__desc {
    color: var(--color-text-light);
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  .services__cta {
    text-align: center;
  }

  @media (min-width: 480px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }

  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
